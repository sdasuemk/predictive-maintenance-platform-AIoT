# Express API Server Port
PORT=3001

# MQTT Ingest Broker Configuration
# Set to 'true' to launch the built-in Aedes broker on port 1883 automatically
USE_EMBEDDED_MQTT=true
# Connection URL for the MQTT publisher client
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=weigh_feeder_sim

# MongoDB Connection settings
# Set to 'true' if you want to log time-series telemetry to database
MONGO_ENABLED=false
# Replace '<db_password>' with your Atlas DB password if using cloud database
MONGO_URI=mongodb://127.0.0.1:27017/pmp_aiot

# Simulator Engine Settings
# Calculation interval frequency in milliseconds (e.g. 2000 = physics updates every 2 seconds)
TICK_INTERVAL_MS=2000

# Acceleration multiplier for progressive anomaly modes (e.g. 10.0 makes failures develop 10x faster)
TIME_ACCELERATION=10.0
